{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/session-start.js", "--data", "${CLAUDE_PLUGIN_DATA}"],
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^trabel-memory:reader$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/reader-hook.js", "--data", "${CLAUDE_PLUGIN_DATA}"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
